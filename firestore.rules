rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidHealthStatus(status) {
      return status in [
        'pending',
        'healthy',
        'warning',
        'unreachable',
        'credential_error',
        'configuration_error',
        'suspected_paused',
        'monitoring_disabled'
      ];
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.email is string && data.email.size() <= 200 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
             data.emailAlertsEnabled is bool &&
             data.inAppAlertsEnabled is bool &&
             data.failureThreshold is int && data.failureThreshold >= 1 && data.failureThreshold <= 10 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProject(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 80 &&
             data.projectUrl is string && data.projectUrl.size() >= 12 && data.projectUrl.size() <= 256 &&
             data.projectUrl.matches('^https://[a-z0-9-]+\\.supabase\\.co$') &&
             data.projectRef is string && data.projectRef.size() >= 3 && data.projectRef.size() <= 64 &&
             data.projectRef.matches('^[a-z0-9-]+$') &&
             data.maskedKey is string && data.maskedKey.size() >= 4 && data.maskedKey.size() <= 64 &&
             data.publishableKeyEncrypted is string && data.publishableKeyEncrypted.size() >= 10 && data.publishableKeyEncrypted.size() <= 2048 &&
             data.keyVersion is int && data.keyVersion >= 1 && data.keyVersion <= 100 &&
             data.healthStatus is string && isValidHealthStatus(data.healthStatus) &&
             data.monitoringEnabled is bool &&
             data.intervalHours is int && data.intervalHours >= 1 && data.intervalHours <= 168 &&
             data.phaseOffsetMinutes is int && data.phaseOffsetMinutes >= 0 && data.phaseOffsetMinutes <= 719 &&
             data.nextCheckEpochMs is int && data.nextCheckEpochMs >= 0 &&
             data.lastCheckedEpochMs is int && data.lastCheckedEpochMs >= 0 &&
             data.lastSuccessEpochMs is int && data.lastSuccessEpochMs >= 0 &&
             data.lastLatencyMs is int && data.lastLatencyMs >= 0 && data.lastLatencyMs <= 60000 &&
             data.consecutiveFailures is int && data.consecutiveFailures >= 0 && data.consecutiveFailures <= 10000 &&
             data.lastSanitizedError is string && data.lastSanitizedError.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMonitoringLog(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 &&
             data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 80 &&
             data.checkType is string && data.checkType in ['manual', 'scheduled', 'validation'] &&
             data.result is string && data.result in ['success', 'failure'] &&
             data.resultingStatus is string && isValidHealthStatus(data.resultingStatus) &&
             data.httpStatus is int && data.httpStatus >= 0 && data.httpStatus <= 599 &&
             data.responseTimeMs is int && data.responseTimeMs >= 0 && data.responseTimeMs <= 60000 &&
             data.errorCode is string && data.errorCode.size() <= 64 &&
             data.errorMessage is string && data.errorMessage.size() <= 500 &&
             data.retryCount is int && data.retryCount >= 0 && data.retryCount <= 5 &&
             data.checkedAtEpochMs is int && data.checkedAtEpochMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidNotification(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 &&
             data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 80 &&
             data.notificationType is string && data.notificationType in [
               'health_alert',
               'credential_error',
               'configuration_error',
               'suspected_paused',
               'recovered'
             ] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
             data.readFlag is bool &&
             data.createdAtEpochMs is int && data.createdAtEpochMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAuditLog(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 64 &&
             data.resourceType is string && data.resourceType in ['project', 'preferences', 'account'] &&
             data.resourceId is string && data.resourceId.size() <= 128 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 240 &&
             data.createdAtEpochMs is int && data.createdAtEpochMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'fullName', 'emailAlertsEnabled',
                         'inAppAlertsEnabled', 'failureThreshold', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'fullName', 'emailAlertsEnabled',
                         'inAppAlertsEnabled', 'failureThreshold', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email', 'fullName', 'emailAlertsEnabled',
                         'inAppAlertsEnabled', 'failureThreshold', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().keys().hasAll([
                           'userId', 'projectName', 'projectUrl', 'projectRef',
                           'maskedKey', 'publishableKeyEncrypted', 'keyVersion',
                           'healthStatus', 'monitoringEnabled', 'intervalHours',
                           'phaseOffsetMinutes', 'nextCheckEpochMs', 'lastCheckedEpochMs',
                           'lastSuccessEpochMs', 'lastLatencyMs', 'consecutiveFailures',
                           'lastSanitizedError', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'projectName', 'projectUrl', 'projectRef',
                           'maskedKey', 'publishableKeyEncrypted', 'keyVersion',
                           'healthStatus', 'monitoringEnabled', 'intervalHours',
                           'phaseOffsetMinutes', 'nextCheckEpochMs', 'lastCheckedEpochMs',
                           'lastSuccessEpochMs', 'lastLatencyMs', 'consecutiveFailures',
                           'lastSanitizedError', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidProject(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(projectId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidProject(incoming(), userId) && (
                           // Action: Toggle monitoring or edit project metadata/key
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'projectName', 'projectUrl', 'projectRef', 'maskedKey',
                             'publishableKeyEncrypted', 'keyVersion', 'healthStatus',
                             'monitoringEnabled', 'intervalHours', 'nextCheckEpochMs',
                             'lastSanitizedError', 'updatedAt'
                           ]) ||
                           // Action: Record health check outcome
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'healthStatus', 'nextCheckEpochMs', 'lastCheckedEpochMs',
                             'lastSuccessEpochMs', 'lastLatencyMs', 'consecutiveFailures',
                             'lastSanitizedError', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      match /logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'projectId', 'projectName', 'checkType', 'result',
                           'resultingStatus', 'httpStatus', 'responseTimeMs',
                           'errorCode', 'errorMessage', 'retryCount', 'checkedAtEpochMs', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'projectId', 'projectName', 'checkType', 'result',
                           'resultingStatus', 'httpStatus', 'responseTimeMs',
                           'errorCode', 'errorMessage', 'retryCount', 'checkedAtEpochMs', 'createdAt'
                         ]) &&
                         isValidMonitoringLog(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(notificationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(notificationId) &&
                         incoming().keys().hasAll([
                           'userId', 'projectId', 'projectName', 'notificationType',
                           'title', 'message', 'readFlag', 'createdAtEpochMs', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'projectId', 'projectName', 'notificationType',
                           'title', 'message', 'readFlag', 'createdAtEpochMs', 'createdAt'
                         ]) &&
                         isValidNotification(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(notificationId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNotification(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['readFlag']);

        allow delete: if isOwner(userId) && isValidId(notificationId);
      }

      match /audit_logs/{auditId} {
        allow get: if isOwner(userId) && isValidId(auditId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(auditId) &&
                         incoming().keys().hasAll([
                           'userId', 'action', 'resourceType', 'resourceId',
                           'summary', 'createdAtEpochMs', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'action', 'resourceType', 'resourceId',
                           'summary', 'createdAtEpochMs', 'createdAt'
                         ]) &&
                         isValidAuditLog(incoming(), userId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(auditId);
      }
    }
  }
}
